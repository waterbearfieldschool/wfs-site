<script>
(function(){
  var hero=document.querySelector(".hero"), st=document.querySelector(".stickytop");
  if(hero&&st){
    var shown=false, revealY=0;
    function measure(){ var had=st.classList.contains("show-nav"); if(had) st.classList.remove("show-nav"); revealY=hero.offsetTop+hero.offsetHeight-72; if(had) st.classList.add("show-nav"); }
    function onScroll(){ var y=window.scrollY||document.documentElement.scrollTop||0; if(!shown&&y>=revealY){ shown=true; st.classList.add("show-nav"); } else if(shown&&y<=revealY-64){ shown=false; st.classList.remove("show-nav"); } }
    measure(); onScroll();
    window.addEventListener("scroll", onScroll, {passive:true});
    window.addEventListener("resize", function(){ measure(); onScroll(); });
  }
  var hams=document.querySelectorAll(".hbtn-ham"), d=document.getElementById("menuDrop");
  if(hams.length&&d){
    hams.forEach(function(b){ b.addEventListener("click",function(e){ e.stopPropagation(); d.classList.toggle("open"); }); });
    d.addEventListener("click",function(e){ if(e.target.tagName==="A") d.classList.remove("open"); });
    document.addEventListener("click",function(e){ if(!d.contains(e.target)&&!e.target.closest(".hbtn-ham")) d.classList.remove("open"); });
    var brand=document.querySelector(".brand"); if(brand){ brand.style.cursor="pointer"; brand.setAttribute("role","button"); brand.addEventListener("click",function(){ window.scrollTo({top:0,behavior:"smooth"}); }); }
  }
})();
</script>
