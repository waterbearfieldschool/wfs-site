  function spy(){
    var line=window.scrollY+sticky.offsetHeight+14, cur=secs[0];
    for(var i=0;i<secs.length;i++){ if(secs[i].offsetTop<=line) cur=secs[i]; }
    var ac=cur.dataset.accent;
    chips.forEach(function(c){ var on=c.dataset.t===cur.id; c.classList.toggle('on',on); c.style.background=on?ac:''; c.style.borderColor=on?ac:''; });
  }
  window.addEventListener('scroll',spy,{passive:true});
  window.addEventListener('resize',spy);
  chips.forEach(function(c){ c.addEventListener('click',function(){
    var el=document.getElementById(c.dataset.t); if(el) el.scrollIntoView({behavior:'smooth'});
  }); });
  spy();
  document.querySelectorAll('.dayrow').forEach(function(r){ r.addEventListener('click',function(){ r.classList.toggle('sel'); updcal(); }); });
  function updcal(){ var n=document.querySelectorAll('.dayrow.sel').length; document.getElementById('calcount').textContent = n? (n+' day'+(n>1?'s':'')+' · $'+(n*20)) : 'No days selected'; }
  function reg(){ var n=document.querySelectorAll('.dayrow.sel').length; var t=document.getElementById('mt'),b=document.getElementById('mb'),e=document.getElementById('me');
    if(!n){ t.textContent='Pick your days first'; b.textContent='Check the days you want, then register.'; }
    else { t.textContent='Registration opens soon '; var items=[].slice.call(document.querySelectorAll('.dayrow.sel')).map(function(x){return '<li>'+x.querySelector('.ddate').textContent+'</li>';}).join(''); b.innerHTML='<div style="margin-bottom:6px">You picked '+n+' day'+(n>1?'s':'')+' — suggested <b>$'+(n*20)+'</b> total (pay what you can):</div><ul class="sellist">'+items+'</ul><div style="margin-top:8px">Send your email and we&rsquo;ll confirm your days the moment sign-ups are live.</div>'; }
    e.href='mailto:info@waterbearfieldschool.org?subject=Field%20Day%20registration'; document.getElementById('ov').classList.add('on'); }
  function togblock(b){ b.classList.toggle('on'); segupd(); }
  function segupd(){ var n=document.querySelectorAll('.blockbtn.on').length; var el=document.getElementById('segcount'); if(el) el.textContent = n? (n+' block'+(n>1?'s':'')+' · $'+(n*100)) : 'No blocks selected'; }
  function segreg(){ var sel=[].slice.call(document.querySelectorAll('.bgrid td.on')); var t=document.getElementById('mt'),b=document.getElementById('mb'),e=document.getElementById('me');
    if(!sel.length){ t.textContent='Pick your blocks first'; b.textContent='Tap a cell — a weekday and a month — to select a block.'; }
    else { t.textContent='Registration opens soon '; var n=sel.length; var items=sel.map(function(x){return '<li>'+x.dataset.day+' · '+x.dataset.block+'</li>';}).join(''); b.innerHTML='<div style="margin-bottom:6px">You picked '+n+' block'+(n>1?'s':'')+' — suggested <b>$'+(n*100)+'</b> total (pay what you can):</div><ul class="sellist">'+items+'</ul><div style="margin-top:8px">Send your email and we&rsquo;ll confirm your spots the moment sign-ups are live.</div>'; }
    e.href='mailto:info@waterbearfieldschool.org?subject=Field%20Day%20monthly%20registration'; document.getElementById('ov').classList.add('on'); }
  function selcell(td){ td.classList.toggle('on'); refresh(); }
  function refresh(){
    document.querySelectorAll('.cg .cell.hl').forEach(function(x){x.classList.remove('hl');x.style.background='';});
    document.querySelectorAll('.bgrid td.on').forEach(function(td){ var col=td.dataset.color; (td.dataset.dates||'').split(',').forEach(function(d){ var el=document.querySelector('.cg .cell[data-d="'+d+'"]'); if(el){el.classList.add('hl'); el.style.background=col;} }); });
    var n=document.querySelectorAll('.bgrid td.on').length; var el=document.getElementById('segcount'); if(el) el.textContent = n?(n+' block'+(n>1?'s':'')+' · $'+(n*100)):'No blocks selected';
  }
  function m(k){var t=document.getElementById('mt'),b=document.getElementById('mb'),e=document.getElementById('me');
   if(k==='r'){t.textContent='Registration opens soon ';b.textContent="We're finalizing our programming. Send us your email and we'll let you know the moment sign-ups are live.";e.href="mailto:info@waterbearfieldschool.org?subject=Let%20me%20know%20when%20registration%20opens";}
   else{t.textContent='Want to know more?';b.textContent="Happy to tell you all about it — email us with any questions and we'll be right in touch.";e.href="mailto:info@waterbearfieldschool.org?subject=More%20info";}
   document.getElementById('ov').classList.add('on');}
  function cl(){document.getElementById('ov').classList.remove('on');}
</script>
