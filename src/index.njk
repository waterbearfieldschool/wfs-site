  .about-foot{max-width:800px;margin:18px auto 0;text-align:center;color:var(--accent-d);font-size:.96rem;line-height:1.45}
  .about-foot .muted{color:var(--muted);font-weight:400}
  .policy{max-width:680px;margin:6px auto 0}
  .policy h3{color:var(--accent-d);font-size:1.12rem;margin:18px 0 5px}
