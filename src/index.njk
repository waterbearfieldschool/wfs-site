  .months{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;max-width:560px;margin:6px auto 0}
  @media(max-width:560px){.months{grid-template-columns:repeat(3,1fr);gap:5px;margin:6px -6px 0}.month{padding:6px 2px 7px}.cg{gap:1px}.cg .dow{font-size:.5rem}.cg .cell{font-size:.6rem}.month h4{font-size:.7rem}}
  .month{background:#fff;border:1px solid var(--line);border-radius:9px;padding:7px 6px 6px;min-width:0;overflow:hidden}
