<script>
  // Move Field Days into Recent as their date passes, without waiting for a
  // rebuild. Every session is in the DOM; the build hid the ones that had not
  // happened yet, and this re-decides against the visitor's own clock.
  (function(){
    if(!window.wfsIsPast) return;
    var shown=0;
    document.querySelectorAll('.pastday').forEach(function(c){
      var past=window.wfsIsPast(c.dataset.date);
      c.hidden=!past;
      if(past) shown++;
    });
    var sec=document.getElementById('journal');
    if(sec) sec.hidden = shown===0;
  })();
</script>
<script>
  // Hide Field Days that have already happened. Done here rather than at build
  // time because a static build only knows the date it was built on.
  (function(){
    if(!window.wfsIsPast) return;
    var hidden=0;
    document.querySelectorAll('.daycard2').forEach(function(c){
      var d=(c.id||'').replace('day-','');
      if(window.wfsIsPast(d)){ c.style.display='none'; hidden++; }
    });
    // a month heading with every day under it gone is a heading over nothing
    document.querySelectorAll('.monthhead').forEach(function(h){
      var m=h.dataset.month;
      var any=[].slice.call(document.querySelectorAll('.daycard2[data-month="'+m+'"]'))
                .some(function(c){ return c.style.display!=='none'; });
      h.style.display = any ? '' : 'none';
    });
    // With nothing left to show, the full lead describes days that don't exist
    // and the section is just a heading over a gap. Swap in a short lead and
    // say plainly that there's nothing on, with a way to hear about the next.
    var anyLeft = [].slice.call(document.querySelectorAll('.daycard2'))
                    .some(function(c){ return c.style.display !== 'none'; });
    if(!anyLeft){
      var full=document.querySelector('#schedule .seclead');
      var short=document.getElementById('leadShort');
      var none=document.getElementById('noDays');
      if(full) full.hidden=true;
      if(short) short.hidden=false;
      if(none) none.hidden=false;
    }
    if(hidden) console.log('[wfs] hid '+hidden+' past Field Day(s)');
  })();
</script>
<script>
  // The spot count is deliberately not shown on the homepage. A full day
  // still says so on its button, so nobody clicks through to a dead end.
  document.addEventListener('wfs.counts', function(e){
    var counts=e.detail||{};
    document.querySelectorAll('.daycard2').forEach(function(c){
      var d=(c.id||'').replace('day-',''), row=counts[d];
      if(!row) return;
      var left=row.remaining;
      var btn=c.querySelector('.btn-reg');
      if(btn && left<=0){ btn.textContent='Full'; btn.style.background='#8a8f88'; }
    });
  });
</script>

