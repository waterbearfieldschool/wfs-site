  @media(min-width:561px) and (max-width:959px){.wrap{padding-top:6px}.showcase{max-width:460px;aspect-ratio:2.7/1;margin:2px auto 0}.hero{max-width:460px;margin:8px auto 6px;padding:0}.hero-cta{gap:6px}.hbtn{padding:9px 22px;font-size:1.02rem}}
