---
permalink: "/register-v4/"
layout: false
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Register — Waterbear Field School</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.snipcart.com/themes/v3.7.1/default/snipcart.css" />
<style>{% include "wfs-preview.css" %}
  .rwrap{max-width:720px;margin:0 auto;padding:8px 20px 90px}
  .rlead{color:var(--muted);margin:2px 0 20px;max-width:600px}
  .cartbtn{margin-left:auto;background:var(--accent);color:#fff;border:none;border-radius:999px;padding:8px 16px;font-weight:800;font-size:.86rem;cursor:pointer;display:inline-flex;gap:6px;align-items:center}
  .cartbtn[hidden]{display:none}
  .slist{display:flex;flex-direction:column;gap:12px}
  .scard{border:1px solid var(--line);border-radius:14px;background:var(--card);padding:15px 16px;display:flex;align-items:center;gap:14px}
  .scard.added{border-color:var(--accent);background:#f2f7f3}
  .scard .sinfo{flex:1;min-width:0}
  .scard .sinfo b{color:var(--accent-d);font-size:1.02rem}
  .scard .sinfo small{display:block;color:var(--muted);font-size:.83rem;font-weight:500;margin-top:1px}
  .scard .skit{display:inline-block;margin-top:5px;font-size:.78rem;font-weight:700;color:#a86f28;background:#fbf3e3;border-radius:6px;padding:2px 8px}
  .regbtn{flex:none;border:none;cursor:pointer;font-weight:800;font-size:.9rem;padding:10px 18px;border-radius:10px;background:var(--accent);color:#fff}
  .regbtn:hover{background:var(--accent-d)}
  .scard.added .regbtn{background:#fff;color:var(--accent-d);border:1.5px solid var(--accent)}
  /* modal */
  .ovl{position:fixed;inset:0;background:rgba(20,30,24,.55);display:none;align-items:center;justify-content:center;padding:18px;z-index:50}
  .ovl.open{display:flex}
  .modal{background:#fff;border-radius:18px;max-width:440px;width:100%;padding:22px 22px 24px;box-shadow:0 20px 60px rgba(0,0,0,.3);max-height:90vh;overflow:auto}
  .modal h2{font-size:1.2rem;color:var(--accent-d);margin:0 0 2px}
  .modal .msub{color:var(--muted);font-size:.85rem;font-weight:600;margin-bottom:8px}
  .freeline{font-size:.86rem;color:var(--accent-d);font-weight:700;background:#eef6f0;border-radius:8px;padding:8px 11px;margin-bottom:6px}
  .mlab{font-weight:700;font-size:.88rem;color:var(--ink);margin:16px 0 7px}
  .tiers{display:flex;flex-wrap:wrap;gap:8px}
  .tier input{position:absolute;opacity:0;width:0;height:0}
  .tier span{display:inline-block;border:1.5px solid var(--line);border-radius:999px;padding:8px 15px;font-weight:700;font-size:.9rem;cursor:pointer;background:#fff;color:var(--ink)}
  .tier input:checked+span{border-color:var(--accent);background:var(--accent);color:#fff}
  .kitrow{display:flex;align-items:center;gap:10px;margin-top:8px;padding:12px 13px;border:1px dashed var(--line);border-radius:11px;background:#fafaf7;font-weight:600;color:var(--accent-d);cursor:pointer}
  .kitrow input{width:17px;height:17px;flex:none;accent-color:var(--accent)}
  .kitrow .kf{color:var(--muted);font-weight:500;margin-left:auto}
  .mactions{display:flex;gap:9px;margin-top:20px}
  .mbtn{flex:1;border:none;cursor:pointer;font-weight:800;font-size:.95rem;padding:12px;border-radius:10px}
  .mbtn.go{background:var(--accent);color:#fff}
  .mbtn.ghost{background:#eef0ea;color:var(--ink)}
  .matnote{font-size:.8rem;color:var(--muted);margin:22px 0 0;max-width:600px}
  .toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%) translateY(20px);background:var(--accent-d);color:#fff;font-weight:700;font-size:.9rem;padding:11px 18px;border-radius:999px;box-shadow:0 8px 24px rgba(0,0,0,.25);opacity:0;transition:.25s;z-index:60;pointer-events:none}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
</style>
</head>
<body>
  <div class="stickytop"><div class="top" style="display:flex;align-items:center;gap:12px"><div class="brand">Waterbear Field School<small>Register for Field Days</small></div>
    <button class="cartbtn snipcart-checkout" id="cartBtn" hidden>🛒 <span class="snipcart-items-count">0</span> · <span class="snipcart-total-price">0.00</span> — Checkout</button>
  </div></div>
  <div class="backbar"><a href="/#schedule">← Back to the schedule</a></div>

  <div class="rwrap">
    <h1 style="font-size:1.6rem;color:var(--accent-d);margin:8px 0 4px">Register for Field Days</h1>
    <p class="rlead">It&rsquo;s free to come and learn. <b>Register for each workshop you&rsquo;d like to join</b> — add it to your list, and if you want, pay what you like or reserve a take-home kit. When you&rsquo;re done, hit <b>Checkout</b> once. If you didn&rsquo;t add a kit or contribution, checkout is free and needs no card.</p>

    <div class="slist">
      {% for s in sessions %}
      <div class="scard" id="card-{{ s.date }}"
           data-date="{{ s.date }}"
           data-title="{{ s.title }}"
           data-when="{{ s.day }} · {{ s.time }} · {{ s.place }}"
           {% if s.materials %}data-kit-label="{{ s.materials.label }}" data-kit-fee="{{ s.materials.fee }}"{% endif %}>
        <div class="sinfo">
          <b>{{ s.day }} · {{ s.title }}</b>
          <small>{{ s.time }} · {{ s.place }}</small>
          {% if s.materials %}<span class="skit">Take-home kit available — {{ s.materials.label }} ${{ s.materials.fee }}</span>{% endif %}
        </div>
        <button class="regbtn" onclick="openReg('{{ s.date }}')">Register →</button>
      </div>
      {% endfor %}
    </div>

    <p class="matnote"><b>Registration is always free.</b> Kits and contributions are optional and paid securely by card at checkout. Everyone gets a confirmation email listing the workshops they registered for.</p>
  </div>

  <div class="ovl" id="ovl"><div class="modal" id="modal"></div></div>
  <div class="toast" id="toast"></div>

  <!-- Snipcart product definitions (hidden, crawlable + clickable) -->
  <div hidden aria-hidden="true">
    {% for s in sessions %}
    <button class="snipcart-add-item" id="def-ws-{{ s.date }}"
      data-item-id="ws-{{ s.date }}"
      data-item-name="{{ s.day }} — {{ s.title }}"
      data-item-price="0.00"
      data-item-url="/register-v4/"
      data-item-description="Field Day registration — {{ s.day }} ({{ s.date }}). Free."
      data-item-quantity="1" data-item-max-quantity="1">ws</button>
    {% if s.materials %}
    <button class="snipcart-add-item" id="def-kit-{{ s.date }}"
      data-item-id="kit-{{ s.date }}"
      data-item-name="{{ s.materials.label }} — {{ s.day }} ({{ s.date }})"
      data-item-price="{{ s.materials.fee }}.00"
      data-item-url="/register-v4/"
      data-item-description="Take-home kit reserved for the {{ s.day }} Field Day. Materials paid in advance."
      data-item-quantity="1" data-item-max-quantity="4">kit</button>
    {% endif %}
    {% endfor %}
    <button class="snipcart-add-item" id="def-contribution-5"  data-item-id="contribution-5"  data-item-name="Field Day contribution — $5"  data-item-price="5.00"  data-item-url="/register-v4/" data-item-description="Optional contribution to keep Field Days free." data-item-quantity="1">c5</button>
    <button class="snipcart-add-item" id="def-contribution-10" data-item-id="contribution-10" data-item-name="Field Day contribution — $10" data-item-price="10.00" data-item-url="/register-v4/" data-item-description="Optional contribution to keep Field Days free." data-item-quantity="1">c10</button>
    <button class="snipcart-add-item" id="def-contribution-20" data-item-id="contribution-20" data-item-name="Field Day contribution — $20" data-item-price="20.00" data-item-url="/register-v4/" data-item-description="Optional contribution to keep Field Days free." data-item-quantity="1">c20</button>
    <button class="snipcart-add-item" id="def-contribution-50" data-item-id="contribution-50" data-item-name="Field Day contribution — $50" data-item-price="50.00" data-item-url="/register-v4/" data-item-description="Optional contribution to keep Field Days free." data-item-quantity="1">c50</button>
  </div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
(function(){
  if(!window.supabase) return;
  var sb=supabase.createClient('https://jhgcnqmzbphzpxgtojti.supabase.co','sb_publishable_VjYvl7U-fWJO0st6R6W7gg_ep7SNTn6');

  // date -> {label} map for turning cart items back into rsvp rows at checkout
  var SESSIONS={ {% for s in sessions %}"{{ s.date }}":{label:{{ s.label | dump | safe }}}{% if not loop.last %},{% endif %}{% endfor %} };

  var ovl=document.getElementById('ovl'), modalEl=document.getElementById('modal'), toastEl=document.getElementById('toast');
  function esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;'); }
  function toast(t){ toastEl.textContent=t; toastEl.classList.add('show'); setTimeout(function(){toastEl.classList.remove('show');},2200); }

  window.openReg=function(date){
    var card=document.getElementById('card-'+date); if(!card) return;
    var d=card.dataset;
    var kit = d.kitFee ? {label:d.kitLabel,fee:d.kitFee} : null;
    modalEl.innerHTML =
      '<h2>'+esc(d.title)+'</h2>'+
      '<div class="msub">'+esc(d.when)+'</div>'+
      '<div class="freeline">✓ Free to attend — added to your registration</div>'+
      '<div class="mlab">Pay what you like <span style="font-weight:500;color:var(--muted)">— optional, keeps days free</span></div>'+
      '<div class="tiers">'+
        '<label class="tier"><input type="radio" name="mc" value="0" checked><span>Free</span></label>'+
        '<label class="tier"><input type="radio" name="mc" value="5"><span>$5</span></label>'+
        '<label class="tier"><input type="radio" name="mc" value="10"><span>$10</span></label>'+
        '<label class="tier"><input type="radio" name="mc" value="20"><span>$20</span></label>'+
        '<label class="tier"><input type="radio" name="mc" value="50"><span>$50</span></label>'+
      '</div>'+
      (kit ? '<div class="mlab">Take-home kit <span style="font-weight:500;color:var(--muted)">— optional</span></div><label class="kitrow"><input type="checkbox" id="mKit"> Reserve the '+esc(kit.label)+' <span class="kf">$'+esc(kit.fee)+' materials</span></label>' : '')+
      '<div class="mactions"><button class="mbtn ghost" type="button" id="mCancel">Cancel</button><button class="mbtn go" type="button" id="mGo">Add to registration →</button></div>';
    ovl.classList.add('open');
    document.getElementById('mCancel').onclick=closeReg;
    document.getElementById('mGo').onclick=function(){ addReg(date, kit); };
  };
  function closeReg(){ ovl.classList.remove('open'); modalEl.innerHTML=''; }
  ovl.addEventListener('click',function(e){ if(e.target===ovl) closeReg(); });

  function addToCart(defId){
    return new Promise(function(resolve){
      var btn=document.getElementById(defId); if(!btn){ resolve(); return; }
      btn.click(); setTimeout(resolve, 350);
    });
  }

  async function addReg(date, kit){
    var go=document.getElementById('mGo'); go.disabled=true; go.textContent='Adding…';
    var contrib=(document.querySelector('input[name="mc"]:checked')||{}).value||'0';
    var wantKit = kit && document.getElementById('mKit') && document.getElementById('mKit').checked;
    if(window.Snipcart){
      await addToCart('def-ws-'+date);                         // the free workshop registration
      if(wantKit) await addToCart('def-kit-'+date);
      if(contrib!=='0') await addToCart('def-contribution-'+contrib);
    }
    var card=document.getElementById('card-'+date);
    card.classList.add('added');
    card.querySelector('.regbtn').textContent='✓ Added — edit';
    closeReg();
    toast('Added '+card.dataset.title+' to your registration');
  }

  // Snipcart wiring: show cart button when non-empty; write RSVPs on completed order
  document.addEventListener('snipcart.ready', function(){
    if(!window.Snipcart) return;
    function refresh(){
      try{ var n=Snipcart.store.getState().cart.items.count; document.getElementById('cartBtn').hidden = !(n>0); }catch(e){}
    }
    refresh(); Snipcart.store.subscribe(refresh);

    // On successful checkout (free $0 orders included), record the RSVPs in Supabase
    Snipcart.events.on('order.completed', async function(order){
      try{
        var email=(order && (order.email || (order.user && order.user.email))) || '';
        var name='';
        try{ name = (order.billingAddress && order.billingAddress.fullName) || order.cardHolderName || ''; }catch(e){}
        var items=(order && order.items) || [];
        var rows=[];
        // which workshops, and did each have a kit?
        var kitDates={};
        items.forEach(function(it){ if(it.id && it.id.indexOf('kit-')===0) kitDates[it.id.slice(4)]=true; });
        items.forEach(function(it){
          if(it.id && it.id.indexOf('ws-')===0){
            var date=it.id.slice(3);
            var label=(SESSIONS[date]&&SESSIONS[date].label)||it.name;
            rows.push({ name:name, email:email, session:label, wants_updates:true, wants_materials: !!kitDates[date] });
          }
        });
        if(rows.length && email){ await sb.from('rsvps').insert(rows); }
      }catch(e){ /* Snipcart already has the order; RSVP write is best-effort */ }
    });
  });
})();
</script>

  <div id="snipcart" data-api-key="{{ site.snipcartApiKey }}" data-config-modal-style="side" hidden></div>
  <script async src="https://cdn.snipcart.com/themes/v3.7.1/default/snipcart.js"></script>
</body>
</html>
