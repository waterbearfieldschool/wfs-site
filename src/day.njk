---
pagination:
  data: sessions
  size: 1
  alias: s
permalink: "{{ s.path }}"
layout: false
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ s.title }} · {{ s.day }} — Waterbear Field School</title>
<meta name="description" content="{{ s.cardBlurb }}">
<link rel="canonical" href="{{ site.url }}{{ s.path }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Waterbear Field School">
<meta property="og:title" content="{{ s.title }} · {{ s.day }}">
<meta property="og:description" content="{{ s.time }} · {{ s.place }} — {{ s.cardBlurb }}">
<meta property="og:url" content="{{ site.url }}{{ s.path }}">
<meta property="og:image" content="{{ site.url }}{{ s.ogImg }}">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:secure_url" content="{{ site.url }}{{ s.ogImg }}">
<meta property="og:image:alt" content="{{ s.title }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ s.title }} · {{ s.day }}">
<meta name="twitter:description" content="{{ s.time }} · {{ s.place }} — {{ s.cardBlurb }}">
<meta name="twitter:image" content="{{ site.url }}{{ s.ogImg }}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Lora:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.snipcart.com/themes/v3.7.1/default/snipcart.css" />
<style>{% include "wfs-preview.css" %}
{% include "wfs-panel.css" %}
{% include "wfs-basket.css" %}

  .teachbox{margin:-2px 0 10px;padding:12px 14px;background:#f3f6f3;border:1px solid #dbe6de;border-radius:10px}
  .teachbox label{display:block;font-size:.86rem;color:var(--muted);line-height:1.4;margin-bottom:7px}
  .teachbox textarea{width:100%;font:inherit;font-size:.93rem;padding:9px 11px;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);resize:vertical}
  .teachbox textarea:focus{outline:none;border-color:var(--accent)}
  .teachmsg{margin-top:7px;font-size:.86rem;font-weight:600;color:#a3402f}
</style>
</head>
<body>
  <div class="stickytop">
    <div class="top">
      <a class="brand" href="/" style="text-decoration:none">Waterbear Field School<small>Hands-on learning &amp; building, near Lincoln, MA</small></a>
      <button class="cartbtn" id="cartBtn" hidden>Cart <span class="cnum" id="cartNum">0</span></button>
    </div>
  </div>

  <div class="backbar"><a href="/">&larr; All Field Days</a></div>

  <div class="wdetail">
    <div class="whero">
      <img src="{{ s.img }}" alt="{{ s.title }}">
      <div class="wband" style="background:linear-gradient(transparent,{{ s.color }}f2)"><h1>{{ s.title }}</h1></div>
    </div>

    <p class="wblurb">{{ s.day }} · {{ s.time }} · {{ s.place }}</p>

    <div class="wsec">
      {% for p in s.about %}<p>{{ p }}</p>{% endfor %}
    </div>

    <div class="tix" id="tix" data-date="{{ s.date }}" data-title="{{ s.title }}" data-label="{{ s.label }}">
      <div class="tix-head">
        <h2>Choose a Registration Type:</h2>
        <p class="tixcap" id="tixCap"></p>
      </div>

      {%- for t in registrationTypes %}
      {%- set p = s.ticketPrice if (t.id == "standard" and s.ticketPrice) else t.price %}
      <div class="trow{% if t.price == 0 %} tfree{% endif %}"
           data-def="def-tix-{{ s.date }}-{{ t.id }}"
           data-pid="tix-{{ s.date }}-{{ t.id }}"
           data-unit="{{ p }}"
           data-kind="reg"
           data-line="{{ s.cartName }}"
           data-sub="{{ t.label }}">
        <span class="tinfo"><b>{{ t.label }}</b><small>{{ t.blurb }}</small></span>
        <span class="tprice">{% if p > 0 %}${{ p }}{% else %}Free{% endif %}</span>
        <span class="qctl">
          <button type="button" class="qbtn" data-step="-1" aria-label="one fewer">&minus;</button>
          <output class="qnum">0</output>
          <button type="button" class="qbtn" data-step="1" aria-label="one more">+</button>
        </span>
      </div>
      {%- if t.teach %}
      <div class="teachbox" id="teachBox" hidden>
        <label for="teachWhat">What might you share? A sentence or two is plenty &mdash; we&rsquo;ll follow up by email or have a chat on the day.</label>
        <textarea id="teachWhat" rows="3" maxlength="600"
                  placeholder="e.g. sourdough from a starter, basic bike repair, mushroom identification&hellip;"></textarea>
        <p class="teachmsg" id="teachMsg" hidden>Tell us roughly what you&rsquo;d share and we&rsquo;ll take it from there.</p>
      </div>
      {%- endif %}
      {%- endfor %}

      {%- if s.materials %}
      <div class="tsub">Take-home kit (optional):</div>
      <div class="trow tkit"
           data-def="def-kit-{{ s.date }}"
           data-pid="kit-{{ s.date }}"
           data-unit="{{ s.materials.fee }}"
           data-kind="kit"
           data-line="{{ s.cartName }}"
           data-sub="Take-home kit — {{ s.kitName }}">
        <span class="tinfo"><b>{{ s.kitName }}</b><small>Pre-paid so we can prepare yours. Add one per thing you&rsquo;d like to take home.</small></span>
        <span class="tprice">${{ s.materials.fee }}<small>each</small></span>
        <span class="qctl">
          <button type="button" class="qbtn" data-step="-1" aria-label="one fewer">&minus;</button>
          <output class="qnum">0</output>
          <button type="button" class="qbtn" data-step="1" aria-label="one more">+</button>
        </span>
      </div>
      {%- endif %}
    </div>

    <div class="tixbar">
      <span class="tixsum" id="tixSum"><b>Nothing selected</b><small>Choose a registration above</small></span>
      <button class="tixgo" id="tixGo" type="button" disabled>Add to my registrations</button>
    </div>

    <dl class="dc-facts">
      <div><dt>When</dt><dd>{{ s.day }} · {{ s.time }}</dd></div>
      <div><dt>Where</dt><dd>{{ s.location }}<br><span class="muted">{{ s.locationNote }}</span></dd></div>
      <div><dt>Who</dt><dd>{{ s.forWhom }}</dd></div>
      <div><dt>Bring</dt><dd>{{ s.bring }}</dd></div>
    </dl>

    <p style="margin:26px 0 0;color:var(--muted)">Want to teach or host a session? <a href="mailto:info@waterbearfieldschool.org?subject=Field%20Days" style="color:{{ s.color }};font-weight:700;text-decoration:underline">Email us</a>.</p>

    <p class="backfoot"><a href="/">&larr; All Field Days</a></p>
  </div>

  <div class="toast" id="toast"></div>

  {% include "wfs-basket-defs.njk" %}
  {% include "wfs-basket-panel.njk" %}
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>{% include "wfs-basket.js" %}</script>
  <script>{% include "wfs-basket-ui.js" %}</script>
  <script>
  // A day that has already happened must not be registerable.
  (function(){
    if(!window.wfsIsPast || !window.wfsIsPast('{{ s.date }}')) return;
    var tix=document.getElementById('tix'), bar=document.querySelector('.tixbar');
    if(tix){
      tix.innerHTML='<div class="tix-head"><h2>This Field Day has passed</h2></div>'+
        '<div class="trow"><span class="tinfo"><b>Registration is closed</b>'+
        '<small>Have a look at what is coming up instead.</small></span>'+
        '<a class="btn-reg" href="/" style="flex:none">Upcoming days &rarr;</a></div>';
    }
    if(bar) bar.remove();
  })();
  </script>
  <script>{% include "wfs-day-panel.js" %}</script>
</body>
</html>
