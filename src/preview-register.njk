---
permalink: "/register/"
layout: false
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Register — Waterbear Field School</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>{% include "wfs-preview.css" %}
  /* ---- register page ---- */
  .rwrap{max-width:620px;margin:0 auto;padding:8px 20px 70px}
  .rlead{color:var(--muted);margin:2px 0 18px;max-width:560px}
  .sesslist{display:flex;flex-direction:column;gap:10px;margin-bottom:22px}
  .sgroup{border:1px solid var(--line);border-radius:12px;background:var(--card);overflow:hidden}
  .srow{display:flex;align-items:center;gap:11px;padding:13px 15px;cursor:pointer}
  .srow input{width:18px;height:18px;flex:none;margin:0;accent-color:var(--accent)}
  .srow .sx{display:flex;flex-direction:column;line-height:1.25}
  .srow .sx b{color:var(--accent-d)}
  .srow .sx small{color:var(--muted);font-size:.82rem;font-weight:500}
  .sgroup.on{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent) inset}
  .matrow{display:none;align-items:center;gap:9px;padding:10px 15px 12px 44px;background:#f3f6f1;border-top:1px dashed var(--line);font-size:.88rem;font-weight:600;color:var(--accent-d);cursor:pointer}
  .matrow.show{display:flex}
  .matrow input{width:16px;height:16px;flex:none;margin:0;accent-color:var(--accent)}
  .matrow .matfee{color:var(--muted);font-weight:500}
  .keeprow{border:1px dashed var(--line);border-radius:12px;background:#fafaf7}
  .fields{display:flex;flex-direction:column;gap:11px;max-width:460px}
  .fields input[type=text],.fields input[type=email]{width:100%;padding:12px 13px;border:1px solid var(--line);border-radius:9px;font:inherit;background:#fff}
  .rvcheck{display:flex;align-items:center;gap:8px;font-weight:500;color:var(--ink)}
  .rvcheck input{margin:0;accent-color:var(--accent)}
  #regBtn{align-self:flex-start;border:none;cursor:pointer;font-size:1rem;padding:13px 26px;margin-top:4px}
  #regBtn:disabled{opacity:.5;cursor:default}
  .rvmsg{font-size:.92rem;font-weight:600;min-height:1.2em}
  .matnote{font-size:.82rem;color:var(--muted);margin:-8px 0 20px;max-width:560px}
</style>
</head>
<body>
  <div class="stickytop"><div class="top"><div class="brand">Waterbear Field School<small>Register for Field Days</small></div></div></div>
  <div class="backbar"><a href="/#schedule">← Back to the schedule</a></div>

  <div class="rwrap">
    <h1 style="font-size:1.6rem;color:var(--accent-d);margin:8px 0 4px">Register for Field Days</h1>
    <p class="rlead">It&rsquo;s free to come and learn — you never have to pay. Registering just helps us plan, lets us send you the exact address, and lets us reach you about weather holds. <b>Pick any days you&rsquo;d like</b>, enter your email once, and you&rsquo;re set.</p>

    <form id="regForm">
      <div class="sesslist">
        <label class="srow keeprow"><input type="checkbox" id="keepPosted" value="Not sure yet — keep me posted"><span class="sx"><b>Not sure yet</b> — just keep me posted<small>Get weather &amp; schedule updates for all Field Days</small></span></label>
        {% for s in sessions %}
        <div class="sgroup" data-date="{{ s.date }}">
          <label class="srow"><input type="checkbox" class="sess" name="sess" value="{{ s.label }}" data-date="{{ s.date }}"><span class="sx"><b>{{ s.day }}</b> · {{ s.title }}<small>{{ s.time }} · {{ s.place }}</small></span></label>
          {% if s.materials %}<label class="matrow" data-date="{{ s.date }}"><input type="checkbox" class="mat" data-date="{{ s.date }}"> I&rsquo;d like to take mine home — {{ s.materials.label }} <span class="matfee">({% if s.materials.pay == "on-site" %}${{ s.materials.fee }} materials, paid on-site{% else %}materials, suggested ${{ s.materials.fee }}{% endif %})</span></label>{% endif %}
        </div>
        {% endfor %}
      </div>
      <p class="matnote"><b>Registration is always free.</b> If you&rsquo;d like to take your finished kit home, we ask you to cover the materials and reserve it here in advance so we can have it ready. (Online payment coming soon — for now we&rsquo;ll follow up to arrange it.)</p>

      <div class="fields">
        <input type="text" id="rName" placeholder="Your name (optional)">
        <input type="email" id="rEmail" placeholder="Email" required>
        <label class="rvcheck"><input type="checkbox" id="rUpdates" checked> Email me updates (weather &amp; changes)</label>
        <button type="submit" id="regBtn" class="btn-reg">Register</button>
        <div id="regMsg" class="rvmsg"></div>
      </div>
    </form>
  </div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
(function(){
  if(!window.supabase) return;
  var sb=supabase.createClient('https://jhgcnqmzbphzpxgtojti.supabase.co','sb_publishable_VjYvl7U-fWJO0st6R6W7gg_ep7SNTn6');

  // reveal a session's materials row only when the session is checked
  function syncGroup(cb){
    var g=cb.closest('.sgroup'); if(!g) return;
    g.classList.toggle('on', cb.checked);
    var m=g.querySelector('.matrow');
    if(m){ m.classList.toggle('show', cb.checked); if(!cb.checked){ var mi=m.querySelector('.mat'); if(mi) mi.checked=false; } }
  }
  document.querySelectorAll('.sess').forEach(function(cb){ cb.addEventListener('change',function(){syncGroup(cb);}); });

  // deep-link: /preview/register/?day=2026-08-19 (repeatable) pre-checks days
  var params=new URLSearchParams(location.search);
  var days=params.getAll('day');
  if(days.length){
    days.forEach(function(d){
      var cb=document.querySelector('.sess[data-date="'+d+'"]');
      if(cb){ cb.checked=true; syncGroup(cb); }
    });
    var first=document.querySelector('.sess[data-date="'+days[0]+'"]');
    if(first) first.closest('.sgroup').scrollIntoView({block:'center'});
  }

  document.getElementById('regForm').addEventListener('submit', async function(e){
    e.preventDefault();
    var btn=document.getElementById('regBtn'), msg=document.getElementById('regMsg');
    var email=document.getElementById('rEmail').value.trim();
    var name=document.getElementById('rName').value.trim();
    var updates=document.getElementById('rUpdates').checked;
    var picked=[].slice.call(document.querySelectorAll('.sess:checked'));
    var keep=document.getElementById('keepPosted').checked;
    if(!email){ msg.style.color='#b23'; msg.textContent='Please add an email so we can reach you.'; return; }
    if(!picked.length && !keep){ msg.style.color='#b23'; msg.textContent='Pick at least one day (or “just keep me posted”).'; return; }

    var rows=picked.map(function(cb){
      var g=cb.closest('.sgroup'); var mat=g.querySelector('.mat');
      return { name:name, email:email, session:cb.value, wants_updates:updates,
               wants_materials: !!(mat && mat.checked) };
    });
    if(keep) rows.push({ name:name, email:email, session:'Not sure yet — keep me posted', wants_updates:true, wants_materials:false });

    btn.disabled=true; btn.textContent='Saving…'; msg.textContent='';
    var res=await sb.from('rsvps').insert(rows);
    btn.disabled=false; btn.textContent='Register';
    if(res.error){ msg.style.color='#b23';
      msg.textContent='Sorry — '+res.error.message+((/relation|does not exist|schema cache|column/i).test(res.error.message)?' (the rsvps table may need updating)':''); return; }

    var mnames=rows.filter(function(r){return r.wants_materials;}).length;
    var dnames=picked.map(function(cb){return cb.value;});
    document.getElementById('regForm').reset();
    document.querySelectorAll('.sgroup.on').forEach(function(g){g.classList.remove('on');});
    document.querySelectorAll('.matrow.show').forEach(function(m){m.classList.remove('show');});
    msg.style.color='var(--accent)';
    msg.innerHTML="You're registered — thanks!"+(dnames.length?' We’ll email the address &amp; any updates for: <b>'+dnames.join('</b>, <b>')+'</b>.':' We’ll keep you posted.')+(mnames?' Materials reserved for '+mnames+' day'+(mnames>1?'s':'')+'.':'');
  });
})();
</script>
</body>
</html>
