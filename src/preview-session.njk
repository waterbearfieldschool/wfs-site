---
pagination:
  data: sessions
  size: 1
  alias: s
permalink: "{{ s.path }}"
layout: false
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ s.title }} · {{ s.day }} — Waterbear Field School</title>
<meta name="description" content="{{ s.cardBlurb }}">
<link rel="canonical" href="{{ site.url }}{{ s.path }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ s.title }} · {{ s.day }} — Waterbear Field School">
<meta property="og:description" content="{{ s.cardBlurb }}">
<meta property="og:url" content="{{ site.url }}{{ s.path }}">
<meta property="og:image" content="{{ site.url }}{{ s.img }}">
<meta property="og:site_name" content="Waterbear Field School">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ s.title }} · {{ s.day }} — Waterbear Field School">
<meta name="twitter:description" content="{{ s.cardBlurb }}">
<meta name="twitter:image" content="{{ site.url }}{{ s.img }}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>{% include "wfs-preview.css" %}</style>
</head>
<body>
  <div class="stickytop">
    <div class="top">
      <a class="brand" href="/" style="text-decoration:none">Waterbear Field School<small>Hands-on learning &amp; building, near Lincoln, MA</small></a>
    </div>
  </div>

  <div class="backbar"><a href="/#day-{{ s.date }}">← All Field Days</a></div>

  <div class="wdetail">
    <div class="whero">
      <img src="{{ s.img }}" alt="{{ s.title }}">
      <div class="wband" style="background:linear-gradient(transparent,{{ s.color }}f2)"><h1>{{ s.title }}</h1></div>
    </div>

    <p class="wblurb">{{ s.day }} · {{ s.time }} · {{ s.place }}</p>

    <div class="wsec">
      {% for p in s.about %}<p>{{ p }}</p>{% endfor %}
    </div>

    {% if s.materials %}
    {% if s.materials.note %}
    <p class="dc-mat" style="margin:16px 0">{{ s.materials.note }}</p>
    {% else %}
    <p class="dc-mat" style="margin:16px 0"><b>Take yours home:</b> {{ s.materials.label }} — <span class="dc-fee">materials, suggested ${{ s.materials.fee }} · register in advance</span></p>
    {% endif %}
    {% endif %}

    <dl class="dc-facts">
      <div><dt>When</dt><dd>{{ s.day }} · {{ s.time }}</dd></div>
      <div><dt>Where</dt><dd>{{ s.location }}<br><span class="muted">{{ s.locationNote }}</span></dd></div>
      <div><dt>Who</dt><dd>{{ s.forWhom }}</dd></div>
      <div><dt>Bring</dt><dd>{{ s.bring }}</dd></div>
    </dl>

    <div class="dc2-actions" style="margin:8px 0 22px">
      <a class="btn-reg" href="/register/?day={{ s.date }}">Register for this day →</a>
    </div>

    <div class="more-days">
      <p style="color:var(--muted);margin:28px 0 10px;font-size:.92rem">Other {{ s.short }} days:</p>
      <div class="daynav">{%- for other in sessions -%}{%- if other.slug == s.slug and other.date != s.date -%}<a href="{{ other.path }}" class="daychip" style="border-color:{{ s.color }}">{{ other.day }} · {{ other.title }}</a>{%- endif -%}{%- endfor -%}</div>
    </div>

    <p style="margin:26px 0 0;color:var(--muted)"><b>Registration is always free.</b> If you'd like to take home a finished kit, we ask you to cover the materials and register in advance so we can have it ready for you.</p>
    <p style="margin:10px 0 0;color:var(--muted)">Want to teach or host a session? <a href="mailto:info@waterbearfieldschool.org?subject=Field%20Days" style="color:{{ s.color }};font-weight:700;text-decoration:underline">Email us</a>.</p>
  </div>
</body>
</html>
