---
pagination:
  data: workshops
  size: 1
  alias: w
permalink: "/w/{{ w.slug }}/"
layout: false
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ w.title }} — Waterbear Field School</title>
<meta name="description" content="{{ w.blurb }}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>{% include "wfs-preview.css" %}</style>
</head>
<body>
  <div class="stickytop">
    <div class="top">
      <div class="brand">Waterbear Field School<small>Hands-on learning &amp; building, near Lincoln, MA</small></div>
    </div>
  </div>

  <div class="backbar"><a href="/#schedule">← All Field Days</a></div>

  <div class="wdetail">
    <div class="whero">
      <img src="{{ w.img }}" alt="{{ w.title }}">
      <div class="wband" style="background:linear-gradient(transparent,{{ w.color }}f2)"><h1>{{ w.emoji }} {{ w.title }}</h1></div>
    </div>

    <p class="wblurb">{{ w.blurb }}</p>
    <p style="color:var(--muted);margin:-10px 0 22px;font-size:.92rem">{{ w.sessions | length }} upcoming day{% if w.sessions | length != 1 %}s{% endif %} — each is its own project. Jump to the one you want:</p>

    <div class="daynav">
      {% for s in w.sessions %}<a href="#day-{{ s.date }}" class="daychip" style="border-color:{{ w.color }}">{{ s.day }} · {{ s.project or w.title }}</a>{% endfor %}
    </div>

    {% for s in w.sessions %}
    <section class="daycard" id="day-{{ s.date }}">
      <div class="daycard-band" style="background:{{ w.color }}">
        <span class="dc-when">📅 {{ s.day }} · {{ s.time }}</span>
        <a class="btn-reg dc-reg" href="/register/?day={{ s.date }}">Register →</a>
      </div>
      <div class="daycard-body">
        <h2>{{ w.emoji }} {{ s.project or w.title }}</h2>
        {% set about = s.about or w.about %}
        {% for p in about %}<p>{{ p }}</p>{% endfor %}

        {% if s.materials %}
        {% if s.materials.note %}
        <p class="dc-mat">{{ s.materials.note }}</p>
        {% else %}
        <p class="dc-mat"><b>Take yours home:</b> {{ s.materials.label }} — <span class="dc-fee">materials, suggested ${{ s.materials.fee }} · register in advance</span></p>
        {% endif %}
        {% endif %}

        <dl class="dc-facts">
          <div><dt>When</dt><dd>{{ s.day }} · {{ s.time }}</dd></div>
          <div><dt>Where</dt><dd>{{ s.location or w.location }}<br><span class="muted">{{ s.locationNote or w.locationNote }}</span></dd></div>
          <div><dt>Who</dt><dd>{{ s.forWhom or w.forWhom }}</dd></div>
          <div><dt>Bring</dt><dd>{{ s.bring or w.bring }}</dd></div>
        </dl>

        <a class="btn-reg" href="/register/?day={{ s.date }}">Register for this day →</a>
      </div>
    </section>
    {% endfor %}

    <p style="margin:26px 0 0;color:var(--muted)"><b>Registration is always free.</b> If you'd like to take home a finished kit, we ask you to cover the materials and register in advance so we can have it ready for you.</p>
    <p style="margin:10px 0 0;color:var(--muted)">Want to teach or host a session? <a href="mailto:info@waterbearfieldschool.org?subject=Field%20Days" style="color:{{ w.color }};font-weight:700;text-decoration:underline">Email us</a>.</p>
  </div>
</body>
</html>
