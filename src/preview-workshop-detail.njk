---
pagination:
  data: workshops
  size: 1
  alias: w
permalink: "/preview/w/{{ w.slug }}/"
layout: false
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ w.title }} — Waterbear Field School</title>
<meta name="description" content="{{ w.blurb }}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>{% include "wfs-preview.css" %}
  /* ---- past-session photo gallery ---- */
  .wgal{margin:30px 0 8px}
  .wgal h2{font-size:1.15rem;color:var(--accent-d);margin:0 0 4px}
  .wgal .wgal-sub{color:var(--muted);font-size:.9rem;margin:0 0 14px}
  .wgal-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}
  .wgal-grid figure{margin:0;background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden}
  .wgal-grid a{display:block}
  .wgal-grid img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;background:#e5e6e0}
  .wgal-grid figcaption{font-size:.8rem;color:var(--muted);padding:7px 10px 9px;line-height:1.35}
</style>
</head>
<body>
  <div class="stickytop">
    <div class="top">
      <a class="brand" href="/preview/" style="text-decoration:none">Waterbear Field School<small>Hands-on learning &amp; building, near Lincoln, MA</small></a>
    </div>
  </div>

  <div class="backbar"><a href="/preview/workshops/">← All workshops</a></div>

  <div class="wdetail">
    <div class="whero">
      <img src="{{ w.img }}" alt="{{ w.title }}">
      <div class="wband" style="background:linear-gradient(transparent,{{ w.color }}f2)"><h1>{{ w.title }}</h1></div>
    </div>

    <p class="wblurb">{{ w.blurb }}</p>

    {% if w.gallery | length %}
    <div class="wgal">
      <h2>Photos from past sessions</h2>
      <p class="wgal-sub">A look at what we've made and learned together in earlier {{ w.short }} days.</p>
      <div class="wgal-grid">
        {% for ph in w.gallery %}
        <figure>
          <a href="{{ ph.src }}" target="_blank" rel="noopener"><img src="{{ ph.src }}" alt="{{ ph.caption }}" loading="lazy"></a>
          {% if ph.caption %}<figcaption>{{ ph.caption }}</figcaption>{% endif %}
        </figure>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if w.sessions | length %}
    <p style="color:var(--muted);margin:24px 0 22px;font-size:.92rem">{{ w.sessions | length }} upcoming day{% if w.sessions | length != 1 %}s{% endif %} — each is its own project. Jump to the one you want:</p>

    <div class="daynav">
      {% for s in w.sessions %}<a href="/w/{{ w.slug }}/{{ s.date }}/" class="daychip" style="border-color:{{ w.color }}">{{ s.day }} · {{ s.project or w.title }}</a>{% endfor %}
    </div>

    {% for s in w.sessions %}
    <section class="daycard" id="day-{{ s.date }}">
      <div class="daycard-band" style="background:{{ w.color }}">
        <a class="dc-when" href="/w/{{ w.slug }}/{{ s.date }}/">{{ s.day }} · {{ s.time }}</a>
        <a class="btn-reg dc-reg" href="/register/?day={{ s.date }}">Register →</a>
      </div>
      <div class="daycard-body">
        <h2><a href="/w/{{ w.slug }}/{{ s.date }}/">{{ s.project or w.title }}</a></h2>
        {% set about = s.about or w.about %}
        {% for p in about %}<p>{{ p }}</p>{% endfor %}

        {% if s.materials %}
        {% if s.materials.note %}
        <p class="dc-mat">{{ s.materials.note }}</p>
        {% else %}
        <p class="dc-mat"><b>Take yours home:</b> {{ s.materials.label }} — <span class="dc-fee">materials, suggested ${{ s.materials.fee }} · register in advance</span></p>
        {% endif %}
        {% endif %}

        <dl class="dc-facts">
          <div><dt>When</dt><dd>{{ s.day }} · {{ s.time }}</dd></div>
          <div><dt>Where</dt><dd>{{ s.location or w.location }}<br><span class="muted">{{ s.locationNote or w.locationNote }}</span></dd></div>
          <div><dt>Who</dt><dd>{{ s.forWhom or w.forWhom }}</dd></div>
          <div><dt>Bring</dt><dd>{{ s.bring or w.bring }}</dd></div>
        </dl>

        <a class="btn-reg" href="/register/?day={{ s.date }}">Register for this day →</a>
      </div>
    </section>
    {% endfor %}
    {% endif %}

    <p style="margin:26px 0 0;color:var(--muted)"><b>Registration is always free.</b> If you'd like to take home a finished kit, we ask you to cover the materials and register in advance so we can have it ready for you.</p>
    <p style="margin:10px 0 0;color:var(--muted)">Have photos from a past session, or want to teach or host one? <a href="mailto:info@waterbearfieldschool.org?subject=Field%20Days" style="color:{{ w.color }};font-weight:700;text-decoration:underline">Email us</a>.</p>
  </div>
</body>
</html>
