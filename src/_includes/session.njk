
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ project }} · {{ day }} — Waterbear Field School</title>
<meta name="description" content="{{ summary or ('What we did at ' + project + ', ' + day + '.') }}">
<link rel="canonical" href="{{ site.url }}/s/{{ sessionSlug }}/">
<meta property="og:type" content="article">
<meta property="og:site_name" content="Waterbear Field School">
<meta property="og:title" content="{{ project }} · {{ day }}">
<meta property="og:description" content="{{ summary or ('What we did at ' + project + ', ' + day + '.') }}">
<meta property="og:image" content="{{ site.url }}{% if photos and photos.length %}{{ photoDir }}{{ photos[0] }}{% else %}{{ img }}{% endif %}">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  :root{--ink:#1f241f;--bg:#f7f7f2;--muted:#6b7168;--accent:#1c4d3a;--accent-d:#123526;--line:#e5e6e0;--card:#fff}
  body{font-family:Inter,system-ui,sans-serif;color:var(--ink);background:var(--bg);line-height:1.55}
  .top{display:flex;align-items:center;justify-content:center;padding:13px 20px;background:#fff;border-bottom:1px solid var(--line)}
  .brand{font-weight:800;font-size:1.38rem;color:var(--accent);text-decoration:none}
  .wrap{max-width:760px;margin:0 auto;padding:22px 24px 40px}
  .backlink{display:inline-block;color:var(--muted);text-decoration:none;font-size:.9rem;font-weight:600;margin-bottom:14px}
  .backlink:hover{color:var(--accent)}
  .eyebrow{display:inline-block;font-size:.78rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#fff;background:var(--c,#1c4d3a);padding:4px 11px;border-radius:99px}
  h1{font-size:clamp(1.5rem,4.4vw,2.1rem);color:var(--accent-d);margin:10px 0 4px;line-height:1.2}
  .when{color:var(--muted);font-size:.96rem;font-weight:600}
  .summary{margin:14px 0 0;font-size:1.06rem;color:var(--accent-d);font-weight:600;line-height:1.45}
  .hero{width:100%;border-radius:12px;margin:20px 0 4px;display:block}
  .prose{margin-top:22px}
  .prose h2{font-size:1.16rem;color:var(--accent-d);margin:26px 0 6px}
  .prose p{margin:0 0 12px}
  .prose ul,.prose ol{margin:0 0 12px 22px}
  .prose li{margin:3px 0}
  .gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;margin-top:24px}
  .gallery img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:10px;display:block}
  .foot{margin-top:34px;padding-top:18px;border-top:1px solid var(--line);font-size:.92rem}
  .foot a{color:var(--accent);font-weight:700;text-decoration:none}
  footer{text-align:center;color:var(--muted);font-size:.86rem;padding:26px 20px 34px}
  footer a{color:var(--muted)}
  @media(max-width:560px){.wrap{padding:14px 14px 30px}}
</style>
</head>
<body>
<header class="top"><a class="brand" href="/">Waterbear Field School</a></header>

<div class="wrap">
  <a class="backlink" href="/#past">&larr; All sessions</a>

  <span class="eyebrow" style="--c:{{ color or '#1c4d3a' }}">{{ categoryLabel or category }}</span>
  <h1>{{ project }}</h1>
  <div class="when">{{ day }} · {{ time }} · {{ place }}</div>

  {%- if summary %}<p class="summary">{{ summary }}</p>{%- endif %}

  {%- if photos and photos.length %}
  <img class="hero" src="{{ photoDir }}{{ photos[0] }}" alt="{{ project }}">
  {%- endif %}

  <div class="prose">{{ content | safe }}</div>

  {%- if photos and photos.length > 1 %}
  <div class="gallery">
    {%- for p in photos.slice(1) %}
    <img src="{{ photoDir }}{{ p }}" alt="" loading="lazy">
    {%- endfor %}
  </div>
  {%- endif %}

  <div class="foot">
    Want to come to the next one? <a href="/#schedule">See what's coming up &rarr;</a>
  </div>
</div>

<footer>Waterbear Field School · Lincoln, MA · <a href="mailto:info@waterbearfieldschool.org">info@waterbearfieldschool.org</a></footer>
</body>
</html>
