{# Prototype notice, with a reset. Anyone poking at this will accumulate cart
   items and cached customer details; and Snipcart caches each product's
   definition as it was when the item was added, so a stale item can behave by
   yesterday's rules. The reset clears all of it in one go. #}
<div class="protobar">
  <b>Prototype</b> &mdash; a design draft for feedback. Registration isn&rsquo;t live; please don&rsquo;t enter real card details.
  <button type="button" class="protoreset" id="protoReset">reset everything</button>
</div>
<script>
(function(){
  var b=document.getElementById('protoReset'); if(!b) return;
  b.onclick=async function(){
    b.disabled=true; b.textContent='resetting…';
    // 1. empty Snipcart's cart, item by item — stale items carry stale rules
    try{
      if(window.Snipcart){
        var items=(Snipcart.store.getState().cart.items.items)||[];
        for(var i=0;i<items.length;i++){
          try{ await Snipcart.api.cart.items.remove(items[i].uniqueId); }catch(e){}
        }
      }
    }catch(e){}
    // 2. our own state: basket, remembered name/email, which days you registered
    try{
      Object.keys(localStorage).forEach(function(k){
        if(k.indexOf('wfs.')===0 || k.indexOf('snipcart')===0) localStorage.removeItem(k);
      });
      Object.keys(sessionStorage).forEach(function(k){
        if(k.indexOf('wfs.')===0 || k.indexOf('snipcart')===0) sessionStorage.removeItem(k);
      });
    }catch(e){}
    location.reload();
  };
})();
</script>
