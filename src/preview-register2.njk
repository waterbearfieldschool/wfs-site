---
permalink: "/register-v2/"
layout: false
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Register — Waterbear Field School</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.snipcart.com/themes/v3.7.1/default/snipcart.css" />
<style>{% include "wfs-preview.css" %}
  /* ---- register page ---- */
  .rwrap{max-width:620px;margin:0 auto;padding:8px 20px 70px}
  .rlead{color:var(--muted);margin:2px 0 18px;max-width:560px}
  .sesslist{display:flex;flex-direction:column;gap:10px;margin-bottom:22px}
  .sgroup{border:1px solid var(--line);border-radius:12px;background:var(--card);overflow:hidden}
  .srow{display:flex;align-items:center;gap:11px;padding:13px 15px;cursor:pointer}
  .srow input{width:18px;height:18px;flex:none;margin:0;accent-color:var(--accent)}
  .srow .sx{display:flex;flex-direction:column;line-height:1.25}
  .srow .sx b{color:var(--accent-d)}
  .srow .sx small{color:var(--muted);font-size:.82rem;font-weight:500}
  .sgroup.on{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent) inset}
  .matrow{display:none;align-items:center;gap:9px;padding:10px 15px 12px 44px;background:#f3f6f1;border-top:1px dashed var(--line);font-size:.88rem;font-weight:600;color:var(--accent-d);cursor:pointer}
  .matrow.show{display:flex}
  .matrow input{width:16px;height:16px;flex:none;margin:0;accent-color:var(--accent)}
  .matrow .matfee{color:var(--muted);font-weight:500}
  .keeprow{border:1px dashed var(--line);border-radius:12px;background:#fafaf7}
  /* ---- contribution block ---- */
  .contrib{border:1px solid var(--line);border-radius:12px;background:var(--card);padding:15px 16px 17px;margin-bottom:22px}
  .contrib h3{font-size:1.02rem;color:var(--accent-d);margin:0 0 3px}
  .contrib p{font-size:.86rem;color:var(--muted);margin:0 0 12px}
  .tiers{display:flex;flex-wrap:wrap;gap:9px}
  .tier{position:relative}
  .tier input{position:absolute;opacity:0;width:0;height:0}
  .tier span{display:inline-block;border:1.5px solid var(--line);border-radius:999px;padding:9px 17px;font-weight:700;font-size:.95rem;cursor:pointer;background:#fff;color:var(--ink);transition:.12s}
  .tier input:checked+span{border-color:var(--accent);background:var(--accent);color:#fff}
  .tier input:focus-visible+span{box-shadow:0 0 0 3px rgba(28,77,58,.25)}
  /* ---- fields ---- */
  .fields{display:flex;flex-direction:column;gap:11px;max-width:460px}
  .fields input[type=text],.fields input[type=email]{width:100%;padding:12px 13px;border:1px solid var(--line);border-radius:9px;font:inherit;background:#fff}
  .rvcheck{display:flex;align-items:center;gap:8px;font-weight:500;color:var(--ink)}
  .rvcheck input{margin:0;accent-color:var(--accent)}
  #regBtn{align-self:flex-start;border:none;cursor:pointer;font-size:1rem;padding:13px 26px;margin-top:4px}
  #regBtn:disabled{opacity:.5;cursor:default}
  .rvmsg{font-size:.92rem;font-weight:600;min-height:1.2em}
  .matnote{font-size:.82rem;color:var(--muted);margin:-8px 0 20px;max-width:560px}
  .paynote{font-size:.8rem;color:var(--muted);margin:8px 0 0}
</style>
</head>
<body>
  <div class="stickytop"><div class="top"><div class="brand">Waterbear Field School<small>Register for Field Days</small></div></div></div>
  <div class="backbar"><a href="/#schedule">← Back to the schedule</a></div>

  <div class="rwrap">
    <h1 style="font-size:1.6rem;color:var(--accent-d);margin:8px 0 4px">Register for Field Days</h1>
    <p class="rlead">It&rsquo;s free to come and learn — you never have to pay. Registering just helps us plan, lets us send you the exact address, and lets us reach you about weather holds. <b>Pick any days you&rsquo;d like</b>, enter your email once, and you&rsquo;re set.</p>

    <form id="regForm">
      <div class="sesslist">
        <label class="srow keeprow"><input type="checkbox" id="keepPosted" value="Not sure yet — keep me posted"><span class="sx"><b>Not sure yet</b> — just keep me posted<small>Get weather &amp; schedule updates for all Field Days</small></span></label>
        {% for s in sessions %}
        <div class="sgroup" data-date="{{ s.date }}">
          <label class="srow"><input type="checkbox" class="sess" name="sess" value="{{ s.label }}" data-date="{{ s.date }}"><span class="sx"><b>{{ s.day }}</b> · {{ s.title }}<small>{{ s.time }} · {{ s.place }}</small></span></label>
          {% if s.materials %}<label class="matrow" data-date="{{ s.date }}"><input type="checkbox" class="mat" data-date="{{ s.date }}" data-kit-id="kit-{{ s.date }}"> Reserve my kit &amp; pay now — {{ s.materials.label }} <span class="matfee">(${{ s.materials.fee }} materials)</span></label>{% endif %}
        </div>
        {% endfor %}
      </div>

      <div class="contrib">
        <h3>Chip in, if you like</h3>
        <p>Field Days are free and always will be. If you&rsquo;re able, a contribution helps us buy materials and keep days free for everyone. Totally optional.</p>
        <div class="tiers">
          <label class="tier"><input type="radio" name="contrib" value="0" checked><span>No thanks</span></label>
          <label class="tier"><input type="radio" name="contrib" value="5"><span>$5</span></label>
          <label class="tier"><input type="radio" name="contrib" value="10"><span>$10</span></label>
          <label class="tier"><input type="radio" name="contrib" value="20"><span>$20</span></label>
          <label class="tier"><input type="radio" name="contrib" value="50"><span>$50</span></label>
        </div>
      </div>

      <p class="matnote"><b>Registration is always free.</b> Kits and contributions are paid securely by card at checkout. If you don&rsquo;t choose either, you&rsquo;ll just be registered — no payment.</p>

      <div class="fields">
        <input type="text" id="rName" placeholder="Your name (optional)">
        <input type="email" id="rEmail" placeholder="Email" required>
        <label class="rvcheck"><input type="checkbox" id="rUpdates" checked> Email me updates (weather &amp; changes)</label>
        <button type="submit" id="regBtn" class="btn-reg">Register</button>
        <div id="regMsg" class="rvmsg"></div>
        <p class="paynote">If you added a kit or contribution, a secure checkout opens after you register.</p>
      </div>
    </form>
  </div>

  <!-- Snipcart product definitions (hidden, but crawlable + clickable for price validation) -->
  <div hidden aria-hidden="true">
    {% for s in sessions %}{% if s.materials %}
    <button class="snipcart-add-item" id="def-kit-{{ s.date }}"
      data-item-id="kit-{{ s.date }}"
      data-item-name="{{ s.materials.label }} — {{ s.day }} ({{ s.date }})"
      data-item-price="{{ s.materials.fee }}.00"
      data-item-url="/register-v2/"
      data-item-description="Take-home kit reserved for the {{ s.day }} Field Day. Materials paid in advance."
      data-item-quantity="1" data-item-max-quantity="4">kit</button>
    {% endif %}{% endfor %}
    <button class="snipcart-add-item" id="def-contribution-5"  data-item-id="contribution-5"  data-item-name="Field Day contribution — $5"  data-item-price="5.00"  data-item-url="/register-v2/" data-item-description="Optional contribution to keep Field Days free." data-item-quantity="1">c5</button>
    <button class="snipcart-add-item" id="def-contribution-10" data-item-id="contribution-10" data-item-name="Field Day contribution — $10" data-item-price="10.00" data-item-url="/register-v2/" data-item-description="Optional contribution to keep Field Days free." data-item-quantity="1">c10</button>
    <button class="snipcart-add-item" id="def-contribution-20" data-item-id="contribution-20" data-item-name="Field Day contribution — $20" data-item-price="20.00" data-item-url="/register-v2/" data-item-description="Optional contribution to keep Field Days free." data-item-quantity="1">c20</button>
    <button class="snipcart-add-item" id="def-contribution-50" data-item-id="contribution-50" data-item-name="Field Day contribution — $50" data-item-price="50.00" data-item-url="/register-v2/" data-item-description="Optional contribution to keep Field Days free." data-item-quantity="1">c50</button>
  </div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
(function(){
  if(!window.supabase) return;
  var sb=supabase.createClient('https://jhgcnqmzbphzpxgtojti.supabase.co','sb_publishable_VjYvl7U-fWJO0st6R6W7gg_ep7SNTn6');

  // reveal a session's kit row only when the session is checked
  function syncGroup(cb){
    var g=cb.closest('.sgroup'); if(!g) return;
    g.classList.toggle('on', cb.checked);
    var m=g.querySelector('.matrow');
    if(m){ m.classList.toggle('show', cb.checked); if(!cb.checked){ var mi=m.querySelector('.mat'); if(mi) mi.checked=false; } }
  }
  document.querySelectorAll('.sess').forEach(function(cb){ cb.addEventListener('change',function(){syncGroup(cb);}); });

  // deep-link: /register-v2/?day=2026-08-19 (repeatable) pre-checks days
  var params=new URLSearchParams(location.search);
  var days=params.getAll('day');
  if(days.length){
    days.forEach(function(d){
      var cb=document.querySelector('.sess[data-date="'+d+'"]');
      if(cb){ cb.checked=true; syncGroup(cb); }
    });
    var first=document.querySelector('.sess[data-date="'+days[0]+'"]');
    if(first) first.closest('.sgroup').scrollIntoView({block:'center'});
  }

  // add one Snipcart product (by definition-button id) and resolve when settled
  function addToCart(defId){
    return new Promise(function(resolve){
      var btn=document.getElementById(defId);
      if(!btn){ resolve(); return; }
      btn.click();
      setTimeout(resolve, 350); // let Snipcart process the add
    });
  }

  document.getElementById('regForm').addEventListener('submit', async function(e){
    e.preventDefault();
    var btn=document.getElementById('regBtn'), msg=document.getElementById('regMsg');
    var email=document.getElementById('rEmail').value.trim();
    var name=document.getElementById('rName').value.trim();
    var updates=document.getElementById('rUpdates').checked;
    var picked=[].slice.call(document.querySelectorAll('.sess:checked'));
    var keep=document.getElementById('keepPosted').checked;
    if(!email){ msg.style.color='#b23'; msg.textContent='Please add an email so we can reach you.'; return; }
    if(!picked.length && !keep){ msg.style.color='#b23'; msg.textContent='Pick at least one day (or “just keep me posted”).'; return; }

    // what did they choose to pay for?
    var kits=[].slice.call(document.querySelectorAll('.mat:checked'));
    var contribVal=(document.querySelector('input[name="contrib"]:checked')||{}).value||'0';
    var hasPayment = kits.length>0 || contribVal!=='0';

    var rows=picked.map(function(cb){
      var g=cb.closest('.sgroup'); var mat=g.querySelector('.mat');
      return { name:name, email:email, session:cb.value, wants_updates:updates,
               wants_materials: !!(mat && mat.checked) };
    });
    if(keep) rows.push({ name:name, email:email, session:'Not sure yet — keep me posted', wants_updates:true, wants_materials:false });

    btn.disabled=true; btn.textContent='Saving…'; msg.textContent='';
    var res=await sb.from('rsvps').insert(rows);
    if(res.error){ btn.disabled=false; btn.textContent='Register'; msg.style.color='#b23';
      msg.textContent='Sorry — '+res.error.message+((/relation|does not exist|schema cache|column/i).test(res.error.message)?' (the rsvps table may need updating)':''); return; }

    // free confirmation copy (shown regardless; checkout opens on top if paying)
    var dnames=picked.map(function(cb){return cb.value;});
    document.getElementById('regForm').reset();
    document.querySelectorAll('.sgroup.on').forEach(function(g){g.classList.remove('on');});
    document.querySelectorAll('.matrow.show').forEach(function(m){m.classList.remove('show');});
    msg.style.color='var(--accent)';
    msg.innerHTML="You're registered — thanks!"+(dnames.length?' We’ll email the address &amp; any updates for: <b>'+dnames.join('</b>, <b>')+'</b>.':' We’ll keep you posted.');

    if(!hasPayment){ btn.disabled=false; btn.textContent='Register'; return; }

    // add paid items to Snipcart, then open checkout
    btn.textContent='Opening checkout…';
    if(!window.Snipcart){ msg.innerHTML+=' <span style="color:#b23">(Payment is still loading — please try the checkout again in a moment.)</span>'; btn.disabled=false; btn.textContent='Register'; return; }
    for(var i=0;i<kits.length;i++){ await addToCart('def-'+kits[i].getAttribute('data-kit-id')); }
    if(contribVal!=='0'){ await addToCart('def-contribution-'+contribVal); }
    try{ Snipcart.api.theme.cart.open(); }catch(err){ var co=document.querySelector('.snipcart-checkout'); if(co) co.click(); }
    btn.disabled=false; btn.textContent='Register';
  });
})();
</script>

  <div id="snipcart" data-api-key="{{ site.snipcartApiKey }}" data-config-modal-style="side" hidden></div>
  <script async src="https://cdn.snipcart.com/themes/v3.7.1/default/snipcart.js"></script>
</body>
</html>
