#!/usr/bin/env python3
"""wfs-subscribers — who is on the newsletter list.

The subscribers table is closed to the publishable key, so this uses the secret
from `pass supabase/wfs-secret`. Nothing here writes, except --unsubscribe.

  wfs-subscribers               everyone, newest first
  wfs-subscribers --count       just the number
  wfs-subscribers --mask        hide addresses (for sharing a screenshot)
  wfs-subscribers --emails      bare addresses, one per line, for pasting into
                                Buttondown/Substack or a mail client
  wfs-subscribers --csv         email,name — the usual import format
  wfs-subscribers --gone        those who have unsubscribed
  wfs-subscribers --unsubscribe someone@example.com
"""

import csv
import io
import json
import subprocess
import sys
import urllib.parse
import urllib.request
import urllib.error

PROJECT = "https://jhgcnqmzbphzpxgtojti.supabase.co"


def key():
    out = subprocess.run(["pass", "supabase/wfs-secret"],
                         capture_output=True, text=True, timeout=20)
    if out.returncode != 0:
        sys.exit("no secret key at `pass supabase/wfs-secret`")
    return out.stdout.strip().splitlines()[0]


def req(k, path, method="GET", body=None, minimal=False):
    headers = {"apikey": k, "Authorization": "Bearer " + k}
    if body is not None:
        headers["Content-Type"] = "application/json"
    if minimal:
        headers["Prefer"] = "return=minimal"
    r = urllib.request.Request(PROJECT + "/rest/v1/" + path, method=method,
                               data=json.dumps(body).encode() if body else None,
                               headers=headers)
    try:
        with urllib.request.urlopen(r, timeout=30) as resp:
            raw = resp.read().decode()
            return json.loads(raw) if raw.strip() else []
    except urllib.error.HTTPError as e:
        sys.exit("supabase: %s %s" % (e.code, e.read().decode()[:300]))


def mask(addr):
    if "@" not in addr:
        return addr
    user, dom = addr.split("@", 1)
    return (user[:2] + "…" if len(user) > 2 else user) + "@" + dom


def main():
    a = sys.argv
    k = key()

    if "--unsubscribe" in a:
        addr = a[a.index("--unsubscribe") + 1].strip().lower()
        req(k, "subscribers?email=eq." + urllib.parse.quote(addr),
            method="PATCH", body={"unsubscribed_at": "now()"}, minimal=True)
        print("unsubscribed: " + addr)
        return 0

    gone = "--gone" in a
    where = "not.is.null" if gone else "is.null"
    rows = req(k, "subscribers?select=email,name,source,created_at,confirmed_at,"
                  "unsubscribed_at&unsubscribed_at=%s&order=created_at.desc" % where)

    if "--count" in a:
        print(len(rows))
        return 0

    if "--emails" in a:
        for r in rows:
            print(r["email"])
        return 0

    if "--csv" in a:
        w = csv.writer(sys.stdout)
        w.writerow(["email", "name"])
        for r in rows:
            w.writerow([r["email"], r.get("name") or ""])
        return 0

    if not rows:
        print("nobody has unsubscribed." if gone else "no subscribers yet.")
        return 0

    masked = "--mask" in a
    print("%d %s\n" % (len(rows), "unsubscribed" if gone else "subscribers"))
    print("  %-34s %-18s %-12s %s" % ("email", "name", "source", "signed up"))
    print("  " + "-" * 76)
    for r in rows:
        addr = mask(r["email"]) if masked else r["email"]
        print("  %-34s %-18s %-12s %s"
              % (addr[:34],
                 (r.get("name") or "")[:18],
                 (r.get("source") or "")[:12],
                 (r.get("created_at") or "")[:10]))

    if not gone:
        n = req(k, "subscribers?select=email&unsubscribed_at=not.is.null")
        if n:
            print("\n  (%d unsubscribed, not listed — wfs-subscribers --gone)" % len(n))
    return 0


if __name__ == "__main__":
    sys.exit(main())
