#!/usr/bin/env python3
"""wfs-asks — what people said they want to learn next, and what they offered to teach.

Two free-text fields ride along with every registration:

  learn_next   "What would you like to learn next?"  — asked of everyone
  teach_offer  what someone offered to teach, if they took the Teach place

Between them they are the demand signal for what to schedule, the raw material
for the newsletter, and the list of people worth following up with. Nothing
reads them automatically, which is the point — they are for you to read.

Uses the secret key from `pass supabase/wfs-secret`. Read-only.

  wfs-asks              both, newest first
  wfs-asks --learn      only "what would you like to learn next"
  wfs-asks --teach      only the offers to teach — the follow-up list
  wfs-asks --mask       hide email addresses
  wfs-asks --since 2026-08-01
"""

import json
import subprocess
import sys
import urllib.request
import urllib.error

PROJECT = "https://jhgcnqmzbphzpxgtojti.supabase.co"


def key():
    out = subprocess.run(["pass", "supabase/wfs-secret"],
                         capture_output=True, text=True, timeout=20)
    if out.returncode != 0:
        sys.exit("no secret key at `pass supabase/wfs-secret`")
    return out.stdout.strip().splitlines()[0]


def get(k, path):
    r = urllib.request.Request(PROJECT + "/rest/v1/" + path,
                               headers={"apikey": k, "Authorization": "Bearer " + k})
    try:
        with urllib.request.urlopen(r, timeout=30) as resp:
            return json.loads(resp.read().decode() or "[]")
    except urllib.error.HTTPError as e:
        sys.exit("supabase: %s %s" % (e.code, e.read().decode()[:300]))


def mask(addr):
    if "@" not in addr:
        return addr
    u, d = addr.split("@", 1)
    return (u[:2] + "…" if len(u) > 2 else u) + "@" + d


def wrap(s, width, indent):
    words, lines, cur = s.split(), [], ""
    for w in words:
        if len(cur) + len(w) + 1 > width:
            lines.append(cur); cur = w
        else:
            cur = (cur + " " + w).strip()
    if cur:
        lines.append(cur)
    return ("\n" + " " * indent).join(lines)


def show(rows, field, heading, masked):
    hits = [r for r in rows if (r.get(field) or "").strip()]
    print("\n%s — %d" % (heading, len(hits)))
    if not hits:
        print("  (nothing yet)")
        return
    for r in hits:
        who = r.get("name") or "someone"
        addr = mask(r["email"]) if masked else r["email"]
        print("\n  %s  <%s>" % (who, addr))
        print("  %s · %s" % (r.get("session_date") or "?", r.get("session") or ""))
        print("    " + wrap(r[field].strip(), 72, 4))


def main():
    a = sys.argv
    k = key()
    q = ("rsvps?select=name,email,session,session_date,learn_next,teach_offer,"
         "created_at&order=created_at.desc")
    if "--since" in a:
        q += "&session_date=gte." + a[a.index("--since") + 1]
    rows = get(k, q)
    masked = "--mask" in a

    want_learn = "--teach" not in a
    want_teach = "--learn" not in a

    if want_learn:
        show(rows, "learn_next", "What people want to learn next", masked)
    if want_teach:
        show(rows, "teach_offer", "Offers to teach — worth following up", masked)
    print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
